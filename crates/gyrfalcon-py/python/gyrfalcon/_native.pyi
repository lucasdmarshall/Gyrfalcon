from os import PathLike
from typing import Dict, List, Optional, Sequence, Tuple, Union

Metadata = List[Tuple[str, str]]

__version__: str

class Hit:
    """One retrieved chunk."""

    chunk_id: int
    doc_id: str
    score: float
    text: str
    start: int
    """Byte offset of the chunk in its document's text."""
    end: int
    metadata: Dict[str, Union[str, List[str]]]
    """The document's metadata; a key that repeats maps to a list."""

class Collection:
    def __init__(
        self,
        path: Union[str, PathLike[str]],
        model_dir: Union[str, PathLike[str]],
        tier: str = "lite",
        create: bool = True,
        warm: str = "eager",
    ) -> None: ...
    @property
    def path(self) -> str: ...
    @property
    def tier(self) -> str: ...
    def add(self, doc_id: str, text: str, metadata: Metadata = ...) -> List[int]: ...
    def add_many(self, docs: Sequence[Tuple[str, str, Metadata]]) -> int: ...
    def add_file(
        self, path: Union[str, PathLike[str]], doc_id: Optional[str] = None, metadata: Metadata = ...
    ) -> int: ...
    def update(self, doc_id: str, text: str, metadata: Metadata = ...) -> int: ...
    def delete(self, doc_id: str) -> int: ...
    def search(self, query: str, k: int = 10, filter: List[Tuple[str, List[str]]] = ...) -> List[Hit]: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...

def tier_files(tier: str) -> List[Tuple[str, str, str]]: ...
def tier_model_dir(tier: str) -> str: ...
def read_file(path: Union[str, PathLike[str]]) -> Tuple[str, List[int]]: ...
def supported_extensions() -> List[str]: ...
